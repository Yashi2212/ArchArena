server {
    listen 80;
    server_name localhost;
    root /usr/share/nginx/html;
    client_max_body_size 64k;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    add_header X-Frame-Options DENY always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'" always;
    location /api/ {
        proxy_pass http://api:8080;
        proxy_set_header Authorization "Bearer ${ARCHARENA_ACCESS_TOKEN}";
        proxy_buffering off;
        proxy_read_timeout 60s;
    }
    location / { try_files $uri $uri/ /index.html; }
    location ~ (^|/)\. { return 404; }
    location ~ \.map$ { return 404; }
    location /assets/ { expires 1y; }
}
